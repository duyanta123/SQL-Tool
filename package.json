{
  "name": "sql-visualizer",
  "description": "Local-first SQL ER and data-flow visualizer with read-only desktop database introspection",
  "author": "SQL Visualizer contributors",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win && npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@dagrejs/dagre": "^3.0.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.2",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "lz-string": "^1.5.0",
    "better-sqlite3": "^12.6.2",
    "mysql2": "^3.15.3",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.16.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "local.sqlvisualizer.desktop",
    "productName": "SQL Visualizer",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
